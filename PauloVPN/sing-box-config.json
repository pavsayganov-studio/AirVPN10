{
  "log": { "level": "warn", "timestamp": false },
  "dns": {
    "servers": [{ "tag": "direct", "address": "8.8.8.8", "strategy": "ipv4_only" }],
    "strategy": "ipv4_only"
  },
  "inbounds": [
    { "type": "socks", "listen": "127.0.0.1", "listen_port": 10808, "tag": "socks-in" },
    { "type": "http", "listen": "127.0.0.1", "listen_port": 10809, "tag": "http-in" }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "type": "urltest",
      "outbounds": ["vless-lithuania", "vless-backup"],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 500,
      "idle_timeout": "30m"
    },
    {
      "tag": "vless-lithuania",
      "type": "vless",
      "server": "ВАШ_СЕРВЕР_ЛИТВА",
      "server_port": 443,
      "uuid": "ВАШ_UUID",
      "tls": { "enabled": true, "server_name": "ВАШ_SNI_ЛИТВА" },
      "transport": { "type": "ws", "path": "/" }
    },
    {
      "tag": "vless-backup",
      "type": "vless",
      "server": "ВАШ_РЕЗЕРВНЫЙ_СЕРВЕР",
      "server_port": 443,
      "uuid": "ВАШ_UUID",
      "tls": { "enabled": true, "server_name": "ВАШ_SNI_РЕЗЕРВ" },
      "transport": { "type": "ws", "path": "/" }
    },
    { "tag": "direct", "type": "direct" }
  ],
  "route": {
    "auto_detect_interface": true,
    "domain_strategy": "prefer_ipv4",
    "rules": [
      { "domain_suffix": ["telegram.org", "t.me", "tdesktop.telega.one"], "outbound": "proxy" }
    ],
    "default_outbound": "proxy"
  },
  "dialer": { "connect_timeout": "12s" }
}
